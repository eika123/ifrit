# Ifrit Environment & Secrets Template
# Copy to config/.env for local overrides (config/.env is git-ignored and loaded automatically by `just`).

# --- Client & CA Configuration Discovery ---
# Colon-separated search order for `ifrit_config.yaml` (local dev checks ./config first;
# distributed nodes default to checking /var/tmp first when run directly).
# IFRIT_CONFIG_PATHS=./config:.:/var/tmp

# Optional explicit config file path (takes precedence over IFRIT_CONFIG_PATHS):
# IFRIT_CONFIG=./config/ifrit_config.yaml

# --- Container & Experiment Defaults ---
# NODES=3
# RINGS=3
# IFRIT_TELEMETRY_CHECKPOINT_INTERVAL=10s

# --- Local Secrets / Credentials (keep actual values only in config/.env) ---
# API_TOKEN=
